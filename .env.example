# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://jobpipeline:jobpipeline@localhost:5432/jobpipeline

# --- Anthropic (scoring) ---
ANTHROPIC_API_KEY=            # Paste your Claude API key here
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_TEMPERATURE=0.3

# --- Local scoring tier (optional) ---
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5:7b
ENABLE_LOCAL_TIER=true

# --- Scrapers ---
JOBSPY_SEARCH_TERM=platform engineer
JOBSPY_LOCATION=Toronto, ON
JOBSPY_RESULTS=50

# --- App ---
LOG_LEVEL=INFO
